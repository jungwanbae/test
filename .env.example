# ─────────────────────────────────────────────────────────────
# autotrader 비밀값 — 이 파일을 .env 로 복사해서 채우세요. (.env 는 커밋 금지)
# ─────────────────────────────────────────────────────────────

# [기본] NH투자증권 나무 PLUG Open API  (https://www.nhplug.com)
NHPLUG_APP_KEY=
NHPLUG_APP_SECRET=
# 11자리 계좌번호. 비워두면 /n2/acctinfo 에서 환경(모의/운영)에 맞는 계좌를 자동 선택
NHPLUG_ACCOUNT=

# [선택] 한국투자증권 KIS Developers  (https://apiportal.koreainvestment.com)
KIS_APP_KEY=
KIS_APP_SECRET=
# 형식: 12345678-01  (종합계좌번호 8자리 - 상품코드 2자리)
KIS_ACCOUNT=

# [선택] 텔레그램 알림
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 실계좌(live) 주문을 허용하려면 정확히 아래 문구를 넣어야 합니다.
# AUTOTRADER_LIVE_CONFIRM=I_UNDERSTAND_THE_RISK
